# Node.js 24 LTS. demo and real use separate databases.
APP_MODE=demo
PORT=3001
# Absolute or relative private data directory
DATA_DIR=./data
# Optional public URLs for provider media delivery.
PUBLIC_BASE_URL=
OAUTH_CALLBACK_URL=
# Encryption key must be outside the database; never prefix with VITE_.
INTEGRATION_ENCRYPTION_KEY=

# Telegram personal account (MTProto); never put these values into VITE_*.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# INTEGRATION_ENCRYPTION_KEY above: 32 random bytes as 64 hex characters.
# npm run telegram:prepare creates it once if empty, keeps the owner login,
# and switches APP_MODE to real. Stop the server before running this command.

# Temporary local testing only. Set true to skip owner password / local limits.
# Server stays bound to 127.0.0.1. Telegram's own limits still apply.
LOCAL_TEST_NO_PASSWORD=false
LOCAL_TEST_NO_RATE_LIMIT=false

# Instagram Page tokens; may also be stored in the separate .env.instagram* files.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_MANGASTORE_ACCESS_TOKEN=
# Seller webhook signature secret, stored in .env.instagram.seller locally.
META_SELLER_APP_ID=
META_SELLER_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Optional Web Push keys. If omitted, generated once in DATA_DIR/vapid.json (600).
# Preserve vapid.json across deployments/backups; never expose the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# HTTPS contact URL or mailto: address for the push service.
VAPID_SUBJECT=

# Optional NAS archive. Mount only the four required directories read-only.
ARCHIVE_ENABLED=false
ARCHIVE_WARM_VIDEOS=false
ARCHIVE_DSM_URL=
ARCHIVE_DSM_USER=
ARCHIVE_DSM_PASSWORD=
FLIBUSTA_BASE_URL=https://flibusta.is
# Paths inside the runtime container; packaged ffmpeg/ffprobe are used by default.
FFMPEG_PATH=
FFPROBE_PATH=
