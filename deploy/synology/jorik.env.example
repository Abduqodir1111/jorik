# Copy to jorik.env locally. Do not put secrets into the image or source archive.
# Keep the existing encryption key so saved Telegram sessions can be decrypted.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
INTEGRATION_ENCRYPTION_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_MANGASTORE_ACCESS_TOKEN=
META_SELLER_APP_ID=
META_SELLER_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Exact final HTTPS origin, with port if nonstandard. No trailing path.
PUBLIC_BASE_URL=
